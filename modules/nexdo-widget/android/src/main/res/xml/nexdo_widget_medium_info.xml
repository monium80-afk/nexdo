<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2. Redrawn every hour (the minimum Android allows is 30 min) so the
     "Today" / "Overdue" label moves on after midnight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/nexdo_widget_description"
  android:initialLayout="@layout/nexdo_widget_medium"
  android:minWidth="250dp"
  android:minHeight="110dp"
  android:previewLayout="@layout/nexdo_widget_medium"
  android:resizeMode="horizontal|vertical"
  android:targetCellWidth="4"
  android:targetCellHeight="2"
  android:updatePeriodMillis="3600000"
  android:widgetCategory="home_screen" />
