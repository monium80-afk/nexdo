# EXPO_PUBLIC_* values are compiled into the app bundle and are readable by
# anyone who installs it. Only put publishable/anon keys here. Everything
# without the prefix stays server-side (app/api/**) and must never gain one.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# Server-side only — never prefix these with EXPO_PUBLIC_.
# CLERK_SECRET_KEY verifies the session token on the API routes (lib/serverAuth.ts).
CLERK_SECRET_KEY=
GEMINI_API_KEY=
# Lets the API routes count each signed-out install's one free onboarding AI
# run (lib/anonymousTrial.ts). Supabase dashboard -> Project Settings -> API
# Keys -> Secret keys. Without it, signed-out AI requests get a 503.
SUPABASE_SECRET_KEY=
